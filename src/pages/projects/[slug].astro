---
import Base from '../../layouts/Base.astro';
import { getCollection, getEntry, render } from 'astro:content';
export async function getStaticPaths() {
  const projects = await getCollection('projects');
  return projects.map((p) => ({ params: { slug: p.id }, props: { entry: p } }));
}
const { entry } = Astro.props;
const { Content } = await render(entry);
const essay = entry.data.essay ? await getEntry('essays', entry.data.essay) : null;
const tagLabel = { building: 'Building now', done: 'Done', client: 'Client work', coming: 'Coming' };
---
<Base title={entry.data.title} description={entry.data.summary}>
  <article class="prose">
    <span class={`tag ${entry.data.status}`}>{tagLabel[entry.data.status]}</span>
    <h1>{entry.data.title}</h1>
    <p class="lede">{entry.data.summary}</p>
    <p class="stack">{entry.data.stack.join(' · ')}{entry.data.repo && <> · <a href={entry.data.repo} target="_blank" rel="noopener">Source on GitHub</a></>}</p>
    {essay && essay.data.status === 'published' && (
      <aside class="callout"><strong>Essay:</strong> <a href={`/writing/${essay.id}`}>{essay.data.title}</a> — the idea this project came from.</aside>
    )}
    <Content />
    <p class="muted back"><a href="/projects">← All projects</a></p>
  </article>
</Base>
