---
import Base from '../layouts/Base.astro';
import { getCollection } from 'astro:content';
const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
const essays = (await getCollection('essays', (e) => e.data.status === 'published'))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 5);
const tagLabel = { building: 'Building now', done: 'Done', client: 'Client work', coming: 'Coming' };
const fmt = (d: Date) => d.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric', timeZone: 'UTC' });
---
<Base>
  <section class="hero">
    <img class="headshot" src="/assets/headshot.png" alt="Elijah Palmer" width="200" height="200">
    <div>
      <p class="eyebrow">BYU Information Systems · Class of 2028</p>
      <h1>Elijah Palmer</h1>
      <p class="lede">
        Automation Consultant at SOLVD, building Salesforce and AI automations for enterprise clients.
        Former medical assistant working toward a career in healthcare administration and health IT.
      </p>
      <div class="actions">
        <a class="btn" href="https://www.linkedin.com/in/elijah-palmer-byu" target="_blank" rel="noopener">LinkedIn</a>
        <a class="btn ghost" href="https://github.com/ewpalmer0707" target="_blank" rel="noopener">GitHub</a>
        <a class="btn ghost" href="mailto:ewpalmer47@gmail.com">Email</a>
      </div>
    </div>
  </section>

  <section id="about">
    <h2>About</h2>
    <p>
      I'm an Information Systems student at BYU's Marriott School and an Automation Consultant at SOLVD,
      a Salesforce and Anthropic consulting partner. In my first year I've automated 10+ business processes
      with Apex and Flow, built a Salesforce-to-SAP integration through MuleSoft, and served as the sole
      consultant on an international client's production org.
    </p>
    <p>
      Before tech I logged 900+ clinical hours as a medical assistant and worked as a CNA. I served two years
      in Cambodia, where I helped lead operations for a 100-person organization and built its health and safety
      programs. Those experiences are why I care about the systems behind patient care, and why my target is
      healthcare administration and health IT.
    </p>
    <ul class="pills" aria-label="Certifications">
      <li>Salesforce Certified Administrator</li>
      <li>Salesforce Platform App Builder</li>
      <li>Anthropic Claude Certified Architect (Foundations)</li>
      <li>Platform Developer I · in progress</li>
    </ul>
  </section>

  <section id="experience">
    <h2>Experience</h2>
    <ol class="timeline">
      <li>
        <div class="when">Nov 2025 – Present</div>
        <div>
          <h3>Automation Consultant · SOLVD</h3>
          <p>Salesforce automation, integrations, and deployments for 5+ enterprise client orgs. Sole consultant on an international equipment-leasing client's production org.</p>
        </div>
      </li>
      <li>
        <div class="when">Apr – Sep 2025</div>
        <div>
          <h3>IT Specialist &amp; Technician · Vivint Smart Home</h3>
          <p>Ranked #3 of 600 technicians in regional sales revenue through consultative upselling.</p>
        </div>
      </li>
      <li>
        <div class="when">Jan – Apr 2025</div>
        <div>
          <h3>CNA · Orem Rehabilitation &amp; Skilled Nursing</h3>
          <p>600+ hours of direct resident care in a skilled nursing setting.</p>
        </div>
      </li>
      <li>
        <div class="when">Jul – Dec 2024</div>
        <div>
          <h3>Medical Assistant · Skyline Family Medicine</h3>
          <p>Primary MA for an assigned provider: intake, vitals, injections, prior authorizations, eClinicalWorks charting.</p>
        </div>
      </li>
      <li>
        <div class="when">2022 – 2024</div>
        <div>
          <h3>Volunteer Representative · Cambodia</h3>
          <p>Helped lead mission-wide operations; built health and safety programs for arriving volunteers. Fluent in Khmer.</p>
        </div>
      </li>
    </ol>
  </section>

  <section id="writing">
    <h2>Writing</h2>
    <p class="muted">Essays I write by hand about what I'm learning, then build a project to prove it. <a href="/writing">All essays →</a></p>
    {essays.length === 0 ? (
      <p class="muted">First essay coming soon.</p>
    ) : (
      <ul class="essay-list">
        {essays.map((e) => (
          <li>
            <span class="when">{fmt(e.data.date)}</span>
            <div>
              <a href={`/writing/${e.id}`}><strong>{e.data.title}</strong></a>
              {e.data.summary && <p>{e.data.summary}</p>}
            </div>
          </li>
        ))}
      </ul>
    )}
  </section>

  <section id="projects">
    <h2>Projects</h2>
    <p class="muted">Each project gets a write-up covering the problem, the decisions, the tools, and what I'd change. <a href="/projects">All projects →</a></p>
    <div class="cards">
      {projects.map((p) => (
        <article class="card">
          <span class={`tag ${p.data.status}`}>{tagLabel[p.data.status]}</span>
          <h3><a href={`/projects/${p.id}`}>{p.data.title}</a></h3>
          <p>{p.data.summary}</p>
          <p class="stack">{p.data.stack.join(' · ')}</p>
        </article>
      ))}
    </div>
  </section>

  <section id="contact">
    <h2>Contact</h2>
    <p>
      Looking for a summer 2027 internship in healthcare administration, health system operations, or health IT.
      If you work in any of those, or in Salesforce and applied AI, I'd love to connect.
    </p>
    <ul class="links">
      <li><a href="mailto:ewpalmer47@gmail.com">ewpalmer47@gmail.com</a></li>
      <li><a href="https://www.linkedin.com/in/elijah-palmer-byu" target="_blank" rel="noopener">linkedin.com/in/elijah-palmer-byu</a></li>
      <li><a href="https://github.com/ewpalmer0707" target="_blank" rel="noopener">github.com/ewpalmer0707</a></li>
      <li><a href="/assets/Elijah-Palmer-Resume.pdf" target="_blank" rel="noopener">Resume (PDF)</a></li>
    </ul>
  </section>
</Base>
